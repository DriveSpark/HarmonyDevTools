{
  "apiType": "stageMode",
  "buildOption": {
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "arguments": "-DOHOS_STL=c++_static",
      "abiFilters": ["arm64-v8a", "x86_64"]
    }
  },
  "targets": [{ "name": "default" }],
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": { "byteCodeHar": true }
    }
  ]
}
